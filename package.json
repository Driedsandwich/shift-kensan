{
  "name": "shift-kensan",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && npm run bundle:api",
    "bundle:api": "esbuild server/vercel-entry.ts --bundle --platform=node --format=esm --target=node22 --outfile=api/analyze.js",
    "test": "vitest run",
    "eval": "tsx eval/run.ts",
    "eval:real": "tsx eval/run.ts --real",
    "verify:ui": "tsx scripts/verify-ui.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vite": "^6.4.0",
    "vitest": "^4.0.0"
  }
}
